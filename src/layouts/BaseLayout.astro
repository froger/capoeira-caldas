---
import '../styles/global.css';
import type { Locale } from '../lib/types';
import { getInstructors, getSite } from '../lib/data';
import { alternateLocale, getRoutes, switchLocalePath } from '../lib/i18n';
import { withBase } from '../lib/paths';
import {
  absoluteUrl,
  organizationSchema,
  personSchema,
  webSiteSchema,
  type JsonLd,
} from '../lib/seo';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  path?: string;
  jsonLd?: JsonLd | JsonLd[];
  ogImage?: string;
}

const { title, description, locale = 'pt', path = '/', jsonLd = [], ogImage = '/images/og-default.jpg' } = Astro.props;
const site = getSite(locale);
const routes = getRoutes(locale);
const siteOrigin = Astro.site ?? 'http://127.0.0.1:4321';
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const desc = description ?? site.description;
const canonical = absoluteUrl(path, siteOrigin);
const alternatePath = switchLocalePath(locale, path);
const alternateHref = absoluteUrl(alternatePath, siteOrigin);
const ogImageUrl = absoluteUrl(ogImage, siteOrigin);
const homeUrl = absoluteUrl('/', siteOrigin);
const aboutUrl = absoluteUrl(routes.about, siteOrigin);

const website = webSiteSchema({
  name: site.name,
  description: site.description,
  url: homeUrl,
  locale,
});

const org = organizationSchema({
  name: site.name,
  description: site.description,
  url: homeUrl,
  email: site.contact.email,
  phone: site.contact.phone,
  address: site.contact.address,
  city: site.contact.city,
  sameAs: [site.social.instagram, site.social.facebook, site.social.x, site.social.youtube],
  locations: site.locations,
});

const people = getInstructors(locale).instructors.map((inst) =>
  personSchema({
    name: inst.name,
    description: inst.bio_short,
    image: absoluteUrl(inst.photo, siteOrigin),
    url: aboutUrl,
    jobTitle: inst.graduation,
  }),
);

const pageSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const schemas = [website, org, ...people, ...pageSchemas];
---

<!doctype html>
<html lang={locale === 'pt' ? 'pt-PT' : 'en'} data-theme="capoeira">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#224435" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'pt' ? 'pt-PT' : 'en'} href={canonical} />
    <link rel="alternate" hreflang={alternateLocale(locale) === 'pt' ? 'pt-PT' : 'en'} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={homeUrl} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : 'en_US'} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar locale={locale} currentPath={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script src="../scripts/navbar.ts"></script>
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
