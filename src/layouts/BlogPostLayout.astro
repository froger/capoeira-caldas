---
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../lib/types';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  path?: string;
  author?: string;
  date?: Date;
  category?: string;
}

const { title, description, locale = 'pt', path = '/', author, date, category } = Astro.props;
---

<BaseLayout title={title} description={description} locale={locale} path={path}>
  <article class="container mx-auto px-4 py-12 max-w-3xl">
    {category && <span class="badge badge-primary mb-4">{category}</span>}
    <h1 class="text-5xl font-display text-azul-celeste mb-4">{title}</h1>
    {(author || date) && (
      <p class="text-sm text-base-content/70 mb-8">
        {author && <span>{author}</span>}
        {author && date && <span> · </span>}
        {date && <time datetime={date.toISOString()}>{date.toLocaleDateString(locale === 'pt' ? 'pt-PT' : 'en-GB')}</time>}
      </p>
    )}
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
