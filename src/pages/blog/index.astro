---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

const locale = 'pt';
const posts = (await getCollection('blog'))
  .filter((p) => p.data.locale === 'pt')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);
---

<PageLayout title="Blog" locale={locale} path="/blog" breadcrumbs={[{ label: 'Início', href: '/' }, { label: 'Blog' }]}>
  <section class="container mx-auto px-4 py-16">
    <h1 class="text-5xl font-display text-azul-celeste mb-8">Blog</h1>
    {featured && (
      <div class="card lg:card-side bg-base-100 shadow-xl mb-12">
        {featured.data.image && <figure><img src={featured.data.image} alt="" /></figure>}
        <div class="card-body">
          <span class="badge badge-primary">{featured.data.category}</span>
          <h2 class="card-title font-display text-3xl">{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <a href={`/blog/${featured.id}`} class="btn bg-verde-brasil text-white border-none w-fit">Ler artigo</a>
        </div>
      </div>
    )}
    <div class="grid md:grid-cols-3 gap-8">
      {rest.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
  </section>
</PageLayout>
