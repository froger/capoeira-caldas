---
import PageLayout from '../../layouts/PageLayout.astro';
import CourseDetail from '../../components/classes/CourseDetail.astro';
import PricingTable from '../../components/classes/PricingTable.astro';
import { getClassProgram, getPricing, getSite } from '../../lib/data';
import { t } from '../../lib/i18n';

const locale = 'pt';
const program = getClassProgram(locale, 'kids')!;
const pricing = getPricing(locale, 'kids');
const site = getSite(locale);
const ctaHref = program.registration_url || `https://wa.me/${site.contact.whatsapp}`;
---

<PageLayout
  title={program.title}
  description={program.description}
  locale={locale}
  path="/aulas/criancas"
  breadcrumbs={[
    { label: t(locale, 'common.home'), href: '/' },
    { label: t(locale, 'pages.classes.title'), href: '/aulas' },
    { label: program.title },
  ]}
>
  <section class="py-16 text-white text-center" style="background: linear-gradient(135deg, #1a3328, #224435);">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl sm:text-5xl font-display mb-4">{program.title}</h1>
      <p class="text-lg">{program.age_range}</p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16 reveal">
    <CourseDetail program={program} locale={locale} />
  </section>

  <section class="container mx-auto px-4 py-16 reveal">
    <h2 class="text-3xl font-display text-azul-celeste mb-8">{t(locale, 'pages.classes.pricing')}</h2>
    <PricingTable plans={pricing.plans} locale={locale} ctaHref={ctaHref} />
  </section>

  <section class="container mx-auto px-4 py-16 reveal">
    <h2 class="text-3xl font-display text-azul-celeste mb-4">{t(locale, 'pages.classes.bring')}</h2>
    <ul class="list-disc list-inside">
      {pricing.bring_items.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</PageLayout>
