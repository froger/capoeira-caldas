---
import PageLayout from '../../layouts/PageLayout.astro';
import CourseTeaser from '../../components/classes/CourseTeaser.astro';
import FAQAccordion from '../../components/contact/FAQAccordion.astro';
import { getClasses, getFaq } from '../../lib/data';
import { t } from '../../lib/i18n';

const locale = 'en';
const { programs } = getClasses(locale);
const faq = getFaq(locale);
const kids = programs.find((p) => p.id === 'kids')!;
const adult = programs.find((p) => p.id === 'adult')!;
---

<PageLayout
  title={t(locale, 'pages.classes.title')}
  description={t(locale, 'pages.classes.description')}
  locale={locale}
  path="/en/classes"
  breadcrumbs={[{ label: t(locale, 'common.home'), href: '/en/' }, { label: t(locale, 'pages.classes.title') }]}
>
  <section class="py-16 text-white text-center" style="background: linear-gradient(135deg, #1a3328, #224435);">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl sm:text-5xl font-display mb-4">{t(locale, 'pages.classes.title')}</h1>
      <p class="text-lg">{t(locale, 'pages.classes.subtitle')}</p>
    </div>
  </section>

  <CourseTeaser program={kids} locale={locale} />
  <CourseTeaser program={adult} locale={locale} />

  <section class="container mx-auto px-4 py-16 reveal">
    <h2 class="text-3xl font-display text-azul-celeste mb-4">{t(locale, 'common.faq')}</h2>
    <FAQAccordion items={faq.items} />
  </section>
</PageLayout>
