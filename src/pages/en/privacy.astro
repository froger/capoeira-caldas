---
import PageLayout from '../../layouts/PageLayout.astro';
import { getSite } from '../../lib/data';
import { t } from '../../lib/i18n';

const locale = 'en';
const site = getSite(locale);
---

<PageLayout
  title={t(locale, 'pages.privacy.title')}
  description={t(locale, 'pages.privacy.description')}
  locale={locale}
  path="/en/privacy"
  breadcrumbs={[{ label: t(locale, 'common.home'), href: '/en/' }, { label: t(locale, 'footer.privacy') }]}
>
  <section class="container mx-auto px-4 py-16 max-w-3xl space-y-6">
    <h1 class="font-display text-azul-celeste">{t(locale, 'pages.privacy.title')}</h1>
    <p>{t(locale, 'pages.privacy.p1')}</p>
    <p>{t(locale, 'pages.privacy.p2')}</p>
    <p>
      {t(locale, 'pages.privacy.p3')}
      {' '}
      <a class="link text-verde-brasil" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
    </p>
  </section>
</PageLayout>
