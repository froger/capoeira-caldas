---
import PageLayout from '../../layouts/PageLayout.astro';
import AboutContent from '../../components/about/AboutContent.astro';
import { getRoutes, t } from '../../lib/i18n';

const locale = 'en';
const routes = getRoutes(locale);
---

<PageLayout
  title={t(locale, 'pages.about.title')}
  description={t(locale, 'pages.about.description')}
  locale={locale}
  path={routes.about}
  breadcrumbs={[
    { label: t(locale, 'common.home'), href: routes.home },
    { label: t(locale, 'pages.about.title') },
  ]}
>
  <AboutContent locale={locale} />
</PageLayout>
