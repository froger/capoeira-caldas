---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactChannels from '../../components/contact/ContactChannels.astro';
import FAQAccordion from '../../components/contact/FAQAccordion.astro';
import { getSite, getFaq } from '../../lib/data';
import { t } from '../../lib/i18n';

const locale = 'en';
const site = getSite(locale);
const faq = getFaq(locale);
---

<PageLayout
  title={t(locale, 'pages.contact.title')}
  locale={locale}
  path="/en/contact"
  breadcrumbs={[{ label: t(locale, 'common.home'), href: '/en/' }, { label: t(locale, 'pages.contact.title') }]}
>
  <section class="container mx-auto px-4 py-16 grid lg:grid-cols-2 gap-12">
    <div>
      <h1 class="text-3xl sm:text-5xl font-display text-azul-celeste mb-8">{t(locale, 'pages.contact.title')}</h1>
      <ContactChannels locale={locale} />
    </div>
    <div>
      <h2 class="text-2xl font-display text-azul-celeste mb-4">{t(locale, 'common.faq')}</h2>
      <FAQAccordion items={faq.items} />
    </div>
  </section>
  <iframe src={site.contact.map_embed_url} class="w-full h-96 border-0 map-embed" loading="lazy" title={t(locale, 'common.map')}></iframe>
</PageLayout>

<a href={`https://wa.me/${site.contact.whatsapp}`} class="fixed bottom-6 right-6 mb-[env(safe-area-inset-bottom)] mr-[env(safe-area-inset-right)] btn btn-circle bg-verde-brasil text-white border-none shadow-lg z-40 min-h-[48px] min-w-[48px]" aria-label={t(locale, 'common.whatsapp')}>💬</a>
