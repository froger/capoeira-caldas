---
import PageLayout from '../../../layouts/PageLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

const locale = 'en';
const posts = (await getCollection('blog'))
  .filter((p) => p.data.locale === 'en')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageLayout title="Blog" locale={locale} path="/en/blog" breadcrumbs={[{ label: 'Home', href: '/en/' }, { label: 'Blog' }]}>
  <section class="container mx-auto px-4 py-16">
    <h1 class="text-5xl font-display text-azul-celeste mb-8">Blog</h1>
    <div class="grid md:grid-cols-3 gap-8">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
  </section>
</PageLayout>
