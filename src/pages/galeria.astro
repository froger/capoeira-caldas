---
import PageLayout from '../layouts/PageLayout.astro';
import GalleryGrid from '../components/gallery/GalleryGrid.astro';
import { getGallery } from '../lib/data';
import { t } from '../lib/i18n';

const locale = 'pt';
const { items } = getGallery(locale);
---

<PageLayout
  title={t(locale, 'pages.gallery.title')}
  locale={locale}
  path="/galeria"
  breadcrumbs={[{ label: t(locale, 'common.home'), href: '/' }, { label: t(locale, 'pages.gallery.title') }]}
>
  <section class="container mx-auto px-4 py-16">
    <h1 class="text-3xl sm:text-5xl font-display text-azul-celeste mb-4">{t(locale, 'pages.gallery.title')}</h1>
    <p class="mb-12 max-w-2xl text-lg leading-relaxed text-base-content/80">
      {t(locale, 'pages.gallery.intro')}
    </p>
    <GalleryGrid items={items} locale={locale} />
  </section>
</PageLayout>
