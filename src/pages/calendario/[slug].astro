---
import PageLayout from '../../layouts/PageLayout.astro';
import EventDetail from '../../components/schedule/EventDetail.astro';
import { getCollection } from 'astro:content';
import { eventSlug } from '../../lib/events';
import { getRoutes, t } from '../../lib/i18n';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events
    .filter((e) => e.data.locale === 'pt')
    .map((event) => ({
      params: { slug: eventSlug(event.id) },
      props: { event },
    }));
}

const locale = 'pt';
const { event } = Astro.props;
const routes = getRoutes(locale);
const slug = eventSlug(event.id);
---

<PageLayout
  title={event.data.title}
  description={event.data.description}
  locale={locale}
  path={`/calendario/${slug}`}
  breadcrumbs={[
    { label: t(locale, 'common.home'), href: '/' },
    { label: t(locale, 'pages.schedule.title'), href: routes.schedule },
    { label: event.data.title },
  ]}
>
  <section class="container mx-auto px-4 py-16">
    <EventDetail event={event} locale={locale} />
  </section>
</PageLayout>
