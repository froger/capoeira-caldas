---
import { breadcrumbSchema } from '../../lib/seo';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const siteOrigin = Astro.site ?? 'http://127.0.0.1:4321';
const schema = breadcrumbSchema(items, siteOrigin);
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

<nav class="container mx-auto px-4 py-4" aria-label="Breadcrumb">
  <div class="breadcrumbs text-base">
    <ul>
      {items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span class="text-verde-brasil">{item.label}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</nav>
