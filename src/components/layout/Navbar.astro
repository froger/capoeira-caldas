---
import type { Locale } from '../../lib/types';
import { getSite } from '../../lib/data';
import { getNav, getRoutes, switchLocalePath, t } from '../../lib/i18n';
import { withBase } from '../../lib/paths';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const site = getSite(locale);
const nav = getNav(locale);
const routes = getRoutes(locale);
const switchPath = switchLocalePath(locale, currentPath);
const activePath = withBase(currentPath);

const links = [
  { label: nav.capoeira, href: `${routes.home}#programs` },
  { label: nav.classes, href: routes.classes },
  { label: nav.schedule, href: routes.schedule },
  { label: nav.about, href: routes.about },
  { label: nav.contact, href: routes.contact },
];

const isActive = (href: string) =>
  activePath === href || (href.includes('#') && activePath === routes.home);
---

<div class="drawer">
  <input id="mobile-nav-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <header class="navbar navbar-glass fixed top-0 z-50 w-full px-4 lg:px-8 transition-all duration-300" id="main-navbar">
      <div class="navbar-start">
        <label
          for="mobile-nav-drawer"
          class="btn btn-ghost btn-circle drawer-button lg:hidden min-h-11 min-w-11"
          aria-label={t(locale, 'common.menu')}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <a href={routes.home} class="flex items-center gap-3 min-h-[44px]">
          <img
            src={withBase('/images/logo_vector.svg')}
            alt={site.name}
            width="56"
            height="56"
            class="h-14 w-14 object-contain"
          />
          <span class="font-display text-xl text-azul-celeste hidden sm:inline">{site.name}</span>
        </a>
      </div>
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 gap-1 text-[18px]">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'min-h-[44px] px-3',
                  isActive(link.href)
                    ? 'text-verde-brasil font-bold underline decoration-verde-brasil decoration-2 underline-offset-4'
                    : 'hover:text-verde-brasil',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="navbar-end gap-2">
        <a href={switchPath} class="btn btn-ghost btn-sm min-h-[44px] hidden lg:flex" aria-label={t(locale, 'common.switch_lang_aria')}>
          {t(locale, 'common.switch_lang')}
        </a>
        <a
          href={site.contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="btn bg-capoeira-red text-white border-none hover:scale-105 transition-transform min-h-[44px] text-sm sm:text-base px-3 sm:px-4"
        >
          <span class="sm:hidden">{t(locale, 'pages.contact.whatsapp_cta')}</span>
          <span class="hidden sm:inline">{site.positioning.navbar_cta}</span>
        </a>
      </div>
    </header>
    <div class="h-20"></div>
  </div>

  <div class="drawer-side z-[60] lg:hidden">
    <label for="mobile-nav-drawer" aria-label={t(locale, 'common.menu')} class="drawer-overlay"></label>
    <nav class="bg-base-100 text-base-content min-h-full w-full flex flex-col p-6 pt-6">
      <div class="flex items-center justify-between mb-8">
        <span class="font-display text-xl text-azul-celeste">{t(locale, 'common.menu')}</span>
        <label for="mobile-nav-drawer" class="btn btn-ghost btn-circle min-h-11 min-w-11" aria-label={t(locale, 'common.menu')}>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </label>
      </div>
      <ul class="flex flex-col gap-1 flex-1 list-none p-0 m-0">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'flex items-center w-full text-base leading-normal min-h-14 py-4 px-4 rounded-lg',
                isActive(link.href) ? 'font-bold text-verde-brasil bg-base-200' : 'text-base-content',
              ]}
              data-close-drawer
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div
        class="mt-auto join w-full"
        role="group"
        aria-label={t(locale, 'common.switch_lang_aria')}
      >
        {locale === 'pt' ? (
          <span
            class="join-item flex flex-1 items-center justify-center min-h-14 text-base font-bold bg-verde-brasil text-white"
            aria-current="true"
          >
            PT
          </span>
        ) : (
          <a
            href={switchPath}
            class="join-item flex flex-1 items-center justify-center min-h-14 text-base font-semibold border border-base-300"
            data-close-drawer
          >
            PT
          </a>
        )}
        {locale === 'en' ? (
          <span
            class="join-item flex flex-1 items-center justify-center min-h-14 text-base font-bold bg-verde-brasil text-white"
            aria-current="true"
          >
            EN
          </span>
        ) : (
          <a
            href={switchPath}
            class="join-item flex flex-1 items-center justify-center min-h-14 text-base font-semibold border border-base-300"
            data-close-drawer
          >
            EN
          </a>
        )}
      </div>
    </nav>
  </div>
</div>

<script>
  const drawer = document.getElementById('mobile-nav-drawer');
  document.querySelectorAll('[data-close-drawer]').forEach((el) => {
    el.addEventListener('click', () => {
      if (drawer instanceof HTMLInputElement) drawer.checked = false;
    });
  });
</script>
