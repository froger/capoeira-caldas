---
import type { Locale } from '../../lib/types';
import { getSite } from '../../lib/data';
import { getNav, getRoutes, switchLocalePath, t } from '../../lib/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const site = getSite(locale);
const nav = getNav(locale);
const routes = getRoutes(locale);
const contactPath = routes.contact ?? (locale === 'pt' ? '/contato' : '/en/contact');
const switchPath = switchLocalePath(locale, currentPath);

const links = [
  { label: nav.capoeira, href: `${routes.home ?? '/'}#programs` },
  { label: nav.classes, href: routes.classes },
  { label: nav.schedule, href: routes.schedule },
  { label: nav.about, href: routes.about },
  { label: nav.gallery, href: routes.gallery },
  { label: nav.blog, href: routes.blog },
  { label: nav.contact, href: routes.contact },
];
---

<header class="navbar navbar-glass fixed top-0 z-50 w-full px-4 lg:px-8 transition-all duration-300" id="main-navbar">
  <div class="navbar-start">
    <div class="dropdown lg:hidden">
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </div>
      <ul tabindex="0" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-52 p-2 shadow-lg">
        {links.map((link) => (
          <li><a href={link.href} class:list={[{ 'font-bold text-verde-brasil': currentPath === link.href }]}>{link.label}</a></li>
        ))}
        <li><a href={switchPath} class="font-semibold">{locale === 'pt' ? 'EN' : 'PT'}</a></li>
      </ul>
    </div>
    <a href={routes.home ?? '/'} class="flex items-center gap-2">
      <img src="/icons/instruments/berimbau.svg" alt="" width="32" height="32" />
      <span class="font-display text-2xl text-azul-celeste hidden sm:inline">{site.name}</span>
    </a>
  </div>
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1 gap-1">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'min-h-[44px] px-3',
              currentPath === link.href || (link.href.includes('#') && currentPath === (routes.home ?? '/'))
                ? 'text-verde-brasil font-bold underline decoration-verde-brasil decoration-2 underline-offset-4'
                : 'hover:text-verde-brasil',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="navbar-end gap-2">
    <a href={switchPath} class="btn btn-ghost btn-sm min-h-[44px] hidden lg:flex" aria-label="Switch language">
      {locale === 'pt' ? 'EN' : 'PT'}
    </a>
    <a
      href={contactPath}
      class="btn bg-capoeira-red text-white border-none hover:scale-105 transition-transform min-h-[44px]"
    >
      {site.positioning.navbar_cta}
    </a>
  </div>
</header>
<div class="h-16"></div>
