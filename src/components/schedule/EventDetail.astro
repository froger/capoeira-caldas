---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { t } from '../../lib/i18n';

interface Props {
  event: CollectionEntry<'events'>;
  locale: 'pt' | 'en';
}

const { event, locale } = Astro.props;
const { Content } = await render(event);
const rsvpLabel = event.data.rsvp_label ?? t(locale, 'common.rsvp');
---

<article class="max-w-3xl">
  <p class="text-base text-verde-brasil font-semibold mb-2">
    {event.data.date.toLocaleDateString(locale === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'long' })}
  </p>
  <h1 class="text-3xl sm:text-5xl font-display text-azul-celeste mb-4">{event.data.title}</h1>
  <p class="text-lg mb-2">{event.data.description}</p>
  <p class="text-base mb-8">📍 {event.data.location}</p>

  <div class="prose max-w-none mb-10">
    <Content />
  </div>

  {event.data.rsvp_url && (
    <a
      href={event.data.rsvp_url}
      class="btn bg-verde-brasil text-white border-none"
      target="_blank"
      rel="noopener noreferrer"
    >
      {rsvpLabel}
    </a>
  )}
</article>
