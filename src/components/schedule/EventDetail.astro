---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { eventDetailPath, isPastEvent } from '../../lib/events';
import { t } from '../../lib/i18n';
import { absoluteUrl, eventSchema } from '../../lib/seo';

interface Props {
  event: CollectionEntry<'events'>;
  locale: 'pt' | 'en';
}

const { event, locale } = Astro.props;
const { Content } = await render(event);
const past = isPastEvent(event.data.date);
const rsvpLabel = event.data.rsvp_label ?? t(locale, 'common.rsvp');
const siteOrigin = Astro.site ?? 'http://127.0.0.1:4321';
const schema = eventSchema({
  name: event.data.title,
  description: event.data.description,
  startDate: event.data.date,
  location: event.data.location,
  url: absoluteUrl(eventDetailPath(locale, event.id), siteOrigin),
  rsvpUrl: past ? undefined : event.data.rsvp_url,
});
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<article class:list={['max-w-3xl', past && 'opacity-80']}>
  {past && (
    <p class="text-sm font-semibold uppercase tracking-wide text-terra-cota mb-3">
      {t(locale, 'common.past_event')}
    </p>
  )}
  <p class="text-base text-verde-brasil font-semibold mb-2">
    {event.data.date.toLocaleDateString(locale === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'long' })}
  </p>
  <h1 class="text-3xl sm:text-5xl font-display text-azul-celeste mb-4">{event.data.title}</h1>
  <p class="text-lg mb-2">{event.data.description}</p>
  <p class="text-base mb-8">📍 {event.data.location}</p>

  <div class="prose max-w-none mb-10">
    <Content />
  </div>

  {event.data.rsvp_url && (
    past ? (
      <span
        class="btn bg-base-300 text-base-content/50 border-none cursor-not-allowed pointer-events-none"
        aria-disabled="true"
      >
        {rsvpLabel}
      </span>
    ) : (
      <a
        href={event.data.rsvp_url}
        class="btn bg-verde-brasil text-white border-none"
        target="_blank"
        rel="noopener noreferrer"
      >
        {rsvpLabel}
      </a>
    )
  )}
</article>
