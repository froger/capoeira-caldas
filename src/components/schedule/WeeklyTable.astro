---
import type { ScheduleClass } from '../../lib/types';
import { t } from '../../lib/i18n';

interface Props {
  classes: ScheduleClass[];
  locale: 'pt' | 'en';
}

const { classes, locale } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="table table-zebra">
    <thead>
      <tr>
        <th>{t(locale, 'common.day')}</th>
        <th>{t(locale, 'common.time')}</th>
        <th>{t(locale, 'common.level')}</th>
        <th>{t(locale, 'common.instructor')}</th>
        <th>{t(locale, 'common.location')}</th>
      </tr>
    </thead>
    <tbody>
      {classes.map((c) => (
        <tr>
          <td>{c.day}</td>
          <td>{c.time}</td>
          <td>{c.level}</td>
          <td>{c.instructor}</td>
          <td>{c.location}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
