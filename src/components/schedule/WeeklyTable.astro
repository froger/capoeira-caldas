---
import type { ScheduleClass } from '../../lib/types';
import { getRoutes, t } from '../../lib/i18n';

interface Props {
  classes: ScheduleClass[];
  locale: 'pt' | 'en';
}

const { classes, locale } = Astro.props;
const routes = getRoutes(locale);
---

<div class="overflow-x-auto">
  <table class="table table-zebra">
    <thead>
      <tr>
        <th>{t(locale, 'common.day')}</th>
        <th>{t(locale, 'common.time')}</th>
        <th>{t(locale, 'common.location')}</th>
      </tr>
    </thead>
    <tbody>
      {classes.map((c) => {
        const audience = c.audience ?? 'adult';
        const href = audience === 'kids' ? routes.classes_kids : routes.classes_adults;
        const label = audience === 'kids'
          ? t(locale, 'home.schedule_tab_kids')
          : t(locale, 'home.schedule_tab_adults');
        return (
          <tr>
            <td>{c.day}</td>
            <td>{c.time}</td>
            <td>
              <div>{c.location}</div>
              <a
                href={href}
                class="badge badge-sm bg-verde-brasil text-white border-none mt-1 hover:opacity-90 transition-opacity"
              >
                {label}
              </a>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
