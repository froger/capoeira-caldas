---
interface Props {
  locale: 'pt' | 'en';
}

const { locale } = Astro.props;
const milestones = locale === 'pt'
  ? [
      { year: '2010', text: 'Fundação do grupo em Lisboa' },
      { year: '2015', text: 'Primeiro batizado com mestres convidados' },
      { year: '2020', text: 'Programa Capoeira Kids lançado' },
      { year: '2026', text: '+200 alunos ativos na roda' },
    ]
  : [
      { year: '2010', text: 'Group founded in Lisbon' },
      { year: '2015', text: 'First batizado with guest mestres' },
      { year: '2020', text: 'Capoeira Kids program launched' },
      { year: '2026', text: '+200 active students in the roda' },
    ];
---

<ul class="timeline timeline-vertical">
  {milestones.map((m, i) => (
    <li>
      {i > 0 && <hr />}
      <div class="timeline-start timeline-box font-display text-verde-brasil">{m.year}</div>
      <div class="timeline-middle">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-verde-brasil">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="timeline-end timeline-box">{m.text}</div>
      {i < milestones.length - 1 && <hr />}
    </li>
  ))}
</ul>
