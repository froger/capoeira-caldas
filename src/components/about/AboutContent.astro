---
import type { Locale } from '../../lib/types';
import { getInstructors, getSite } from '../../lib/data';
import { t } from '../../lib/i18n';
import { toWebpPath, withBase } from '../../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { instructors } = getInstructors(locale);
const site = getSite(locale);
const pedrinha = instructors.find((i) => i.id === 'pedrinha');
const groupImage = withBase(toWebpPath('/images/about-associacao-capoeira-caldas-da-rainha.jpg'));
---

<section class="py-12 text-white" style="background: linear-gradient(135deg, #1a3328, #224435);">
  <div class="container mx-auto px-4 py-16 text-center">
    <h1 class="text-3xl sm:text-5xl font-display mb-4">{t(locale, 'pages.about.title')}</h1>
    <p class="text-lg max-w-2xl mx-auto">{t(locale, 'pages.about.subtitle')}</p>
  </div>
</section>

<section class="container mx-auto px-4 py-16">
  <img
    src={groupImage}
    alt={t(locale, 'pages.about.group_alt')}
    width="1200"
    height="675"
    class="w-full h-auto object-cover mb-12"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="max-w-3xl mx-auto space-y-6 text-lg sm:text-xl leading-relaxed">
    <p>{t(locale, 'pages.about.intro_p1')}</p>
    <p>{t(locale, 'pages.about.intro_p2')}</p>
    <p>{t(locale, 'pages.about.intro_p3')}</p>
    <p>{t(locale, 'pages.about.intro_p4')}</p>
  </div>
</section>

<section class="container mx-auto px-4 pt-32 pb-16 reveal">
  <h2 class="text-3xl font-display text-azul-celeste mb-6">{t(locale, 'pages.about.locations_title')}</h2>
  <ul class="space-y-3 text-base max-w-2xl">
    <li>
      <strong>{t(locale, 'pages.about.location_caldas')}</strong> — {site.contact.address}
    </li>
    <li>
      <strong>{t(locale, 'pages.about.location_gaeiras')}</strong> — {t(locale, 'pages.about.location_gaeiras_place')}
    </li>
  </ul>
</section>

<section class="container mx-auto px-4 pb-16 reveal">
  <h2 class="text-3xl font-display text-azul-celeste mb-6">{t(locale, 'pages.about.pedrinha_title')}</h2>
  <div class="grid md:grid-cols-2 gap-10 items-start max-w-4xl">
    {pedrinha && (
      <img
        src={pedrinha.photo}
        alt={pedrinha.name}
        width="480"
        height="480"
        class="w-full max-w-sm aspect-square object-cover"
        loading="lazy"
      />
    )}
    <p class="text-base leading-relaxed">{t(locale, 'pages.about.pedrinha_body')}</p>
  </div>
</section>

<section class="container mx-auto px-4 py-16 reveal">
  <h2 class="text-3xl font-display text-azul-celeste mb-8">{t(locale, 'pages.about.instructors_title')}</h2>
  <div class="grid md:grid-cols-3 gap-8">
    {instructors.map((inst) => (
      <div class="card bg-base-100 shadow-md">
        <figure class="px-6 pt-6">
          <img src={inst.photo} alt={inst.name} width="400" height="400" class="rounded-xl w-full aspect-square object-cover" loading="lazy" decoding="async" />
        </figure>
        <div class="card-body">
          <h3 class="font-display text-xl">{inst.name}</h3>
          {inst.graduation && (
            <span class="badge bg-verde-brasil text-white border-none w-fit">{inst.graduation}</span>
          )}
          <p class="text-base">{inst.bio}</p>
        </div>
      </div>
    ))}
  </div>
</section>
