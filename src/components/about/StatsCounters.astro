---
import type { Locale } from '../../lib/types';
import { getSite } from '../../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
---

<section class="py-12 bg-base-200 reveal">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {site.stats.map((stat) => (
        <div>
          <p class="text-5xl font-display text-verde-brasil counter" data-target={stat.value}>0</p>
          <p class="text-sm mt-2">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<script src="../../scripts/counters.ts"></script>
