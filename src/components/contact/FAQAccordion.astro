---
import type { FaqItem } from '../../lib/types';
import { faqPageSchema } from '../../lib/seo';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
const schema = faqPageSchema(items);
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<div class="space-y-2">
  {items.map((item, i) => (
    <div class="collapse collapse-arrow bg-base-200">
      <input type="radio" name="faq-accordion" checked={i === 0} aria-label={item.question} />
      <div class="collapse-title font-semibold">{item.question}</div>
      <div class="collapse-content"><p>{item.answer}</p></div>
    </div>
  ))}
</div>
