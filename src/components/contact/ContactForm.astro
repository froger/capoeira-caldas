---
import type { Locale } from '../../lib/types';
import { getSite } from '../../lib/data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const subjects = locale === 'pt'
  ? ['Aula Experimental', 'Inscrição', 'Eventos', 'Outro']
  : ['Trial Class', 'Enrollment', 'Events', 'Other'];
---

<form class="space-y-4" action={site.forms.contact_formspree || `mailto:${site.contact.email}`} method="get">
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="form-control">
    <label class="label"><span class="label-text">{locale === 'pt' ? 'Nome' : 'Name'}</span></label>
    <input type="text" name="name" class="input input-bordered" required />
  </div>
  <div class="form-control">
    <label class="label"><span class="label-text">Email</span></label>
    <input type="email" name="email" class="input input-bordered" required />
  </div>
  <div class="form-control">
    <label class="label"><span class="label-text">{locale === 'pt' ? 'Telefone' : 'Phone'}</span></label>
    <input type="tel" name="phone" class="input input-bordered" />
  </div>
  <div class="form-control">
    <label class="label"><span class="label-text">{locale === 'pt' ? 'Assunto' : 'Subject'}</span></label>
    <select name="subject" class="select select-bordered">
      {subjects.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>
  <div class="form-control">
    <label class="label"><span class="label-text">{locale === 'pt' ? 'Mensagem' : 'Message'}</span></label>
    <textarea name="body" class="textarea textarea-bordered h-32" required></textarea>
  </div>
  <button type="submit" class="btn bg-verde-brasil text-white border-none min-h-[44px]">
    {locale === 'pt' ? 'Enviar Mensagem' : 'Send Message'}
  </button>
</form>
