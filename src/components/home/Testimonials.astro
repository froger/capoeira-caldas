---
import type { Locale } from '../../lib/types';
import { getTestimonials } from '../../lib/data';
import { t } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { testimonials } = getTestimonials(locale);
---

<section class="py-20 bg-base-200 reveal">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-display text-azul-celeste mb-8">{t(locale, 'home.testimonials_title')}</h2>
    <div class="carousel carousel-center w-full gap-4 p-4">
      {testimonials.map((item) => (
        <div class="carousel-item w-full sm:w-96">
          <div class="card bg-base-100 shadow-lg w-full">
            <div class="card-body">
              <div class="flex gap-1 mb-2">
                {Array.from({ length: item.rating }).map(() => (
                  <span class="text-amarelo-sol">★</span>
                ))}
              </div>
              <p class="italic">"{item.quote}"</p>
              <div class="flex items-center gap-3 mt-4">
                <div class="avatar">
                  <div class="w-12 rounded-full"><img src={item.avatar} alt="" /></div>
                </div>
                <div>
                  <p class="font-semibold">{item.name}</p>
                  <p class="text-sm text-base-content/70">{item.level}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
