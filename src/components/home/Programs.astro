---
import type { Locale } from '../../lib/types';
import { getClasses } from '../../lib/data';
import { t } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { programs } = getClasses(locale);
---

<section id="programs" class="py-20 bg-cream reveal">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl sm:text-5xl font-display text-azul-celeste mb-12">{t(locale, 'home.programs_title')}</h2>
    <div class="grid md:grid-cols-2 gap-10">
      {programs.map((program) => (
        <div class="card bg-base-100 shadow-lg hover:-translate-y-1 hover:shadow-xl transition-all">
          <figure>
            <img
              src={program.image}
              alt={program.title}
              width="640"
              height="480"
              class="w-full aspect-[4/3] object-cover"
              loading="lazy"
            />
          </figure>
          <div class="card-body">
            <h3 class="card-title font-display text-3xl text-azul-celeste">{program.title}</h3>
            <p class="text-base leading-relaxed">{program.description}</p>
            <p class="text-base text-base-content/80">{program.age_range} · {program.schedule_note}</p>
            <div class="grid grid-cols-2 gap-3 my-4">
              {program.pillars.map((pillar) => (
                <div class="flex items-center gap-2 text-base">
                  <span class="text-xl">{pillar.icon}</span>
                  <span>{pillar.label}</span>
                </div>
              ))}
            </div>
            <div class="card-actions">
              <a href={program.path} class="btn bg-verde-brasil text-white border-none text-base">{t(locale, 'common.see_more')}</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
