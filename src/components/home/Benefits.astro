---
import type { Locale } from '../../lib/types';
import { getSite } from '../../lib/data';
import { t } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
---

<section class="py-20 bg-base-200 reveal">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl sm:text-5xl font-display text-azul-celeste mb-12 text-center">
      {t(locale, 'home.benefits_title')}
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {site.positioning.value_themes.map((theme) => (
        <div class="overflow-hidden bg-base-100 shadow-md hover:-translate-y-1 hover:shadow-lg transition-all">
          {theme.image && (
            <img
              src={theme.image}
              alt={theme.title}
              width="640"
              height="400"
              class="w-full aspect-[4/3] object-cover"
              loading="lazy"
            />
          )}
          <div class="p-6 text-center">
            <h3 class="font-display text-2xl text-azul-celeste mb-2">{theme.title}</h3>
            <p class="text-base leading-relaxed">{theme.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
