---
import type { Locale } from '../../lib/types';
import { getGallery } from '../../lib/data';
import { getRoutes, t } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { items } = getGallery(locale);
const preview = items.slice(0, 4);
const routes = getRoutes(locale);
---

<section class="py-20 bg-base-200 reveal">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-display text-azul-celeste mb-8">{t(locale, 'home.gallery_title')}</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
      {preview.map((item) => (
        <div class="relative group overflow-hidden rounded-xl aspect-square">
          <img src={item.thumbnail ?? item.src} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy" />
          {item.type === 'video' && (
            <div class="absolute inset-0 flex items-center justify-center bg-black/30">
              <span class="text-4xl text-white">▶</span>
            </div>
          )}
        </div>
      ))}
    </div>
    <a href={routes.gallery} class="btn bg-verde-brasil text-white border-none">{t(locale, 'home.gallery_cta')}</a>
  </div>
</section>
