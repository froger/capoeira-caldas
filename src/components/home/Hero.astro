---
import WaveDivider from '../decor/WaveDivider.astro';
import type { Locale } from '../../lib/types';
import { getSite } from '../../lib/data';
import { getRoutes, t } from '../../lib/i18n';
import { withBase } from '../../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const site = getSite(locale);
const routes = getRoutes(locale);
const contactPath = routes.contact;
const headline = t(locale, 'home.hero_headline');
const subhead = t(locale, 'home.hero_subhead');
const poster = withBase('/images/hero-poster.jpg');
const videoSrc = withBase('/video/background-video.mp4');
---

<section class="relative min-h-[85vh] sm:min-h-screen overflow-hidden flex items-center">
  <img
    src={poster}
    alt=""
    width="464"
    height="832"
    class="absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
    decoding="async"
  />
  <video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    poster={poster}
    aria-hidden="true"
    data-hero-video
  >
    <source data-src={videoSrc} type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-[#224435]/65"></div>

  <div class="container mx-auto px-4 py-20 sm:py-24 relative z-10 max-w-4xl text-white">
    <p class="font-display text-2xl sm:text-4xl text-amarelo-sol mb-3 hidden sm:block">{site.name}</p>
    <h1 class="text-3xl sm:text-5xl lg:text-7xl font-display leading-tight mb-6">{headline}</h1>
    <p class="text-lg sm:text-2xl text-white/95 mb-8 sm:mb-10 max-w-2xl leading-relaxed">{subhead}</p>
    <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4">
      <a
        href={site.contact.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-lg bg-amarelo-sol text-dark-blue border-none hover:scale-105 transition-transform min-h-[48px] text-base sm:text-lg"
      >
        {site.positioning.primary_cta}
      </a>
      <a href={contactPath} class="btn btn-lg btn-outline text-white border-white hover:bg-white/10 min-h-[48px] text-base sm:text-lg">
        {t(locale, 'home.cta_secondary')}
      </a>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 z-10">
    <WaveDivider />
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const source = video.querySelector('source');
    const src = source?.dataset.src;
    if (source && src) {
      const load = () => {
        source.src = src;
        video.load();
        void video.play().catch(() => {});
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(load, { timeout: 2000 });
      } else {
        window.addEventListener('load', () => setTimeout(load, 200));
      }
    }
  }
</script>
