---
import type { Locale } from '../../lib/types';
import { getSchedule } from '../../lib/data';
import { getRoutes, t } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const schedule = getSchedule(locale);
const routes = getRoutes(locale);
---

<section class="py-20 bg-cream reveal">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl font-display text-azul-celeste mb-6">{t(locale, 'home.schedule_title')}</h2>
    <div class="overflow-x-auto bg-base-100 border border-base-300 rounded-box mb-6">
      <table class="table">
        <thead>
          <tr>
            <th>{t(locale, 'common.day')}</th>
            <th>{t(locale, 'common.time')}</th>
            <th>{t(locale, 'common.level')}</th>
            <th>{t(locale, 'common.location')}</th>
          </tr>
        </thead>
        <tbody>
          {schedule.classes.map((c) => {
            const audience = c.audience ?? 'adult';
            const href = audience === 'kids' ? routes.classes_kids : routes.classes_adults;
            const label = audience === 'kids'
              ? t(locale, 'home.schedule_tab_kids')
              : t(locale, 'home.schedule_tab_adults');
            return (
              <tr>
                <td>{c.day}</td>
                <td>{c.time}</td>
                <td>{c.level}</td>
                <td>
                  <div>{c.location}</div>
                  <a
                    href={href}
                    class="badge badge-sm bg-verde-brasil text-white border-none mt-1 hover:opacity-90 transition-opacity"
                  >
                    {label}
                  </a>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <a href={routes.schedule} class="btn bg-verde-brasil text-white border-none">{t(locale, 'home.schedule_cta')}</a>
  </div>
</section>
