---
import type { ClassProgram, Locale } from '../../lib/types';
import { t } from '../../lib/i18n';

interface Props {
  program: ClassProgram;
  locale: Locale;
}

const { program, locale } = Astro.props;
---

<section class="container mx-auto px-4 py-16 reveal">
  <div class="grid md:grid-cols-2 gap-10 items-center">
    <img
      src={program.image}
      alt={program.title}
      width="640"
      height="480"
      class="w-full aspect-[4/3] object-cover"
      loading="lazy"
    />
    <div>
      <h2 class="text-3xl sm:text-4xl font-display text-azul-celeste mb-4">{program.title}</h2>
      <p class="text-base text-base-content/80 mb-2">{program.age_range}</p>
      <p class="text-base leading-relaxed mb-8">{program.description}</p>
      <a href={program.path} class="btn bg-verde-brasil text-white border-none text-base">
        {t(locale, 'common.see_more')}
      </a>
    </div>
  </div>
</section>
