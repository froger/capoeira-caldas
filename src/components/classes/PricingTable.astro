---
import type { PricingPlan } from '../../lib/types';
import { getSite } from '../../lib/data';

interface Props {
  plans: PricingPlan[];
  locale: 'pt' | 'en';
  ctaHref?: string;
}

const { plans, locale, ctaHref } = Astro.props;
const site = getSite(locale);
const defaultHref = `https://wa.me/${site.contact.whatsapp}`;
const href = ctaHref || defaultHref;
---

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {plans.map((plan) => (
    <div class:list={['card bg-base-100 shadow-md', { 'ring-2 ring-verde-brasil': plan.highlighted }]}>
      <div class="card-body">
        <h3 class="card-title font-display text-xl">{plan.name}</h3>
        <p class="text-3xl font-bold text-verde-brasil">{plan.price}</p>
        <p class="text-base text-base-content/80">{plan.period}</p>
        <ul class="list-disc list-inside text-base my-4 space-y-1">
          {plan.features.map((f) => <li>{f}</li>)}
        </ul>
        <a href={href} target="_blank" rel="noopener noreferrer" class="btn btn-sm bg-verde-brasil text-white border-none mt-auto">{plan.cta}</a>
      </div>
    </div>
  ))}
</div>
