{
  "name": "capoeira-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop content admin for Capoeira Caldas",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:electron": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "electron .",
    "pack": "yarn build && electron-builder --publish never",
    "electron-builder": "electron-builder"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "gray-matter": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.8",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.8"
  }
}
